from fastapi import Depends, FastAPI
from app.routers import (
    weather,
    alerts,
    location,
    chat,
    ingestion,
    real_data,
    history,
    features,
    prediction,
    multi_prediction,
    rainfall,
    hydrology,
    flood_prediction,
    hazards,
    safety,
    weather_chat,
    location_search,
)
from sqlalchemy import text
from sqlalchemy.orm import Session

from app.config import settings
from app.database import Base, engine, get_db
from app.models import WeatherObservation, WeatherAlert

    weather,
    alerts,
    location,
    chat
)

Base.metadata.create_all(bind=engine)

app = FastAPI(
    title=settings.APP_NAME,
    version="1.0.0",
    description="WeatherGPT Weather Intelligence Backend"
)

app.include_router(weather.router)
app.include_router(alerts.router)
app.include_router(location.router)
app.include_router(chat.router)
app.include_router(ingestion.router)
app.include_router(real_data.router)
app.include_router(history.router)
app.include_router(features.router)
app.include_router(prediction.router)
app.include_router(multi_prediction.router)
app.include_router(rainfall.router)
app.include_router(hydrology.router)
app.include_router(flood_prediction.router)
app.include_router(hazards.router)
app.include_router(safety.router)
app.include_router(weather_chat.router)
app.include_router(location_search.router)



@app.get("/")
def root():
    return {
        "name": "WeatherGPT",
        "status": "running",
        "phase": 2
    }

@app.get("/health")
def health(
    db: Session = Depends(get_db)
):
    db.execute(text("SELECT 1"))

    return {
        "status": "healthy",
        "database": "connected"
    }











