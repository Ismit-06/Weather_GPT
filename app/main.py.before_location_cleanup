# ===== DIRECT LOCATION SEARCH =====

@app.get("/location/search")
async def location_search(
    query: str = Query(
        ...,
        min_length=2,
        max_length=100
    )
):
    query = query.strip()

    results = await search_location(
        query=query,
        language="en",
        count=5
    )

    # Prefer Indian results when available.
    india_results = [
        result
        for result in results
        if result.get("country_code") == "IN"
    ]

    if india_results:
        results = india_results

    return {
        "status": "success",
        "query": query,
        "count": len(results),
        "results": results
    }
