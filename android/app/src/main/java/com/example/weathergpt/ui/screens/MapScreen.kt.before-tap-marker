        modifier =
            Modifier.fillMaxSize()
    ) {

        AndroidView(

            modifier =
                Modifier.fillMaxSize(),

            factory = { context ->

                MapView(context).apply {

                    setTileSource(
                        TileSourceFactory.MAPNIK
                    )

                    setMultiTouchControls(true)

                    controller.setZoom(
                        11.0
                    )

                    controller.setCenter(
                        defaultLocation
                    )

                    val compass =
                        CompassOverlay(
                            context,
                            this
                        )

                    compass.enableCompass()

                    overlays.add(
                        compass
