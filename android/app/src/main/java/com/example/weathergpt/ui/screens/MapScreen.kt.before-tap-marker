// ============================================================
// FLOOD OVERLAY CLEANUP
// ============================================================

private fun removeFloodOverlays(
    map: MapView
) {

    val iterator =
        map.overlays.iterator()

    while (
        iterator.hasNext()
    ) {

        val overlay =
            iterator.next()

        if (
            overlay is Polygon
        ) {

            iterator.remove()
        }
    }

    map.invalidate()
}


// =================================================================
// DATA MARKER CLEANUP
// =================================================================

private fun clearDataMarkers(
    map: MapView
) {

    val iterator =
        map.overlays.iterator()

    while (
        iterator.hasNext()
    ) {

        val overlay =
            iterator.next()

        if (
            overlay is Marker &&
            overlay.title != "WeatherGPT"
        ) {

            iterator.remove()
        }
    }
}


// ============================================================
// CLEAR ALL SMART-MAP DATA OVERLAYS
// ============================================================

private fun clearSmartMapOverlays(
    map: MapView
) {

    val iterator =
        map.overlays.iterator()

    while (
        iterator.hasNext()
    ) {

        val overlay =
            iterator.next()

        if (
            overlay is Marker &&
            overlay.title != "WeatherGPT"
        ) {
            iterator.remove()
            continue
        }

        if (
            overlay is Polygon
        ) {
            iterator.remove()
            continue
        }
    }

    map.invalidate()
}
