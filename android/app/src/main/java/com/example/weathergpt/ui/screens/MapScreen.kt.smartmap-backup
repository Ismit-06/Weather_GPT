import org.osmdroid.views.overlay.compass.CompassOverlay


@Composable
fun MapScreen() {

    /*
     * Default location:
     * Vijayawada.
     *
     * Later this will be replaced by the user's actual GPS
     * location from your LocationStore.
     */
    val defaultLocation =
        GeoPoint(
            16.5062,
            80.6480
        )

    var selectedLayer by remember {
        mutableStateOf("Weather")
    }

    var mapView by remember {
        mutableStateOf<MapView?>(null)
    }

    /*
     * Configure osmdroid once.
     */
    DisposableEffect(Unit) {

        Configuration
            .getInstance()
            .userAgentValue =
            "WeatherGPT/1.0"

        onDispose {
            mapView?.onDetach()
        }
    }

    Box(
        modifier =
            Modifier.fillMaxSize()
    ) {

        // =========================================================
        // MAP
        // =========================================================

        AndroidView(

            modifier =
                Modifier.fillMaxSize(),

            factory = { context ->

                MapView(context).apply {

                    setTileSource(
                        TileSourceFactory.MAPNIK
                    )

                    setMultiTouchControls(true)

                    controller.setZoom(11.0)

                    controller.setCenter(
                        defaultLocation
                    )

                    /*
                     * Compass
                     */
                    val compass =
                        CompassOverlay(
                            context,
                            this
                        )

                    compass.enableCompass()

                    overlays.add(
                        compass
                    )

                    /*
                     * User-selected weather intelligence
                     * marker.
                     */
                    val marker =
                        Marker(this)

                    marker.position =
                        defaultLocation

                    marker.title =
                        "WeatherGPT"

                    marker.snippet =
                        "Smart weather intelligence"

                    overlays.add(
                        marker
                    )

                    invalidate()

                    mapView = this
                }
            },

            update = { view ->

                mapView = view
            }
        )

        // =========================================================
        // TOP SEARCH / STATUS CARD
        // =========================================================

        Surface(

            modifier =
                Modifier
                    .fillMaxWidth()
                    .padding(
                        horizontal = 14.dp,
                        vertical = 12.dp
                    )
                    .shadow(
                        10.dp,
                        RoundedCornerShape(18.dp)
                    ),

            shape =
                RoundedCornerShape(18.dp),

            color =
                Color.White.copy(
                    alpha = 0.96f
                )
        ) {

            Row(
                modifier =
                    Modifier.padding(
                        horizontal = 14.dp,
                        vertical = 11.dp
                    ),

                horizontalArrangement =
                    Arrangement.SpaceBetween,

                verticalAlignment =
                    Alignment.CenterVertically
            ) {

                Column(
                    modifier =
                        Modifier.weight(1f)
                ) {

                    Text(
                        text =
                            "SMART MAP",

                        color =
                            Color(0xFF087F8C),

                        fontSize = 10.sp
                    )

                    Text(
                        text =
                            "Weather intelligence",

                        color =
                            Color(0xFF17212B),

                        fontSize = 18.sp
                    )

                    Text(
                        text =
                            "OpenStreetMap • Live layers",

                        color =
                            Color(0xFF71808F),

                        fontSize = 11.sp
                    )
                }

                IconButton(
                    onClick = {
                        mapView?.controller?.animateTo(
                            defaultLocation
                        )
                    }
                ) {

                    Icon(
                        imageVector =
                            Icons.Default.LocationOn,

                        contentDescription =
                            "My location",

                        tint =
                            Color(0xFF137CBD)
                    )
                }
            }
        }

        // =========================================================
        // LAYER CONTROL
        // =========================================================

        Surface(

            modifier =
                Modifier
                    .align(
                        Alignment.TopCenter
                    )
                    .padding(
                        top = 108.dp,
                        start = 12.dp,
                        end = 12.dp
                    ),

            shape =
                RoundedCornerShape(16.dp),

            color =
                Color.White.copy(
                    alpha = 0.94f
                )
        ) {

            Row(

                modifier =
                    Modifier
                        .horizontalScroll(
                            rememberScrollState()
                        )
                        .padding(
                            horizontal = 8.dp,
                            vertical = 7.dp
                        ),

                horizontalArrangement =
                    Arrangement.spacedBy(6.dp)
            ) {

                MapLayerChip(
                    text = "Weather",
                    selected =
                        selectedLayer == "Weather",
                    onClick = {
                        selectedLayer = "Weather"
                    }
                )

                MapLayerChip(
                    text = "Rain",
                    selected =
                        selectedLayer == "Rain",
                    onClick = {
                        selectedLayer = "Rain"
                    }
                )

                MapLayerChip(
                    text = "Flood",
                    selected =
                        selectedLayer == "Flood",
                    onClick = {
                        selectedLayer = "Flood"
                    }
                )

                MapLayerChip(
                    text = "Alerts",
                    selected =
                        selectedLayer == "Alerts",
                    onClick = {
                        selectedLayer = "Alerts"
                    }
                )

                MapLayerChip(
                    text = "Dams",
                    selected =
                        selectedLayer == "Dams",
                    onClick = {
                        selectedLayer = "Dams"
                    }
                )

                MapLayerChip(
                    text = "Quakes",
                    selected =
                        selectedLayer == "Quakes",
                    onClick = {
                        selectedLayer = "Quakes"
                    }
                )
            }
        }

        // =========================================================
        // SELECTED LAYER STATUS
        // =========================================================

        Surface(

            modifier =
                Modifier
                    .align(
                        Alignment.BottomStart
                    )
                    .padding(
                        start = 14.dp,
                        bottom = 16.dp
                    )
                    .shadow(
                        8.dp,
                        RoundedCornerShape(18.dp)
                    ),

            shape =
                RoundedCornerShape(18.dp),

            color =
                Color(0xF5FFFFFF)
        ) {

            Row(
                modifier =
                    Modifier.padding(
                        horizontal = 14.dp,
                        vertical = 11.dp
                    ),

                verticalAlignment =
                    Alignment.CenterVertically
            ) {

                LayerIcon(
                    layer =
                        selectedLayer
                )

                Spacer(
                    modifier =
                        Modifier.size(9.dp)
                )

                Column {

                    Text(
                        text =
                            selectedLayer.uppercase(),

                        color =
                            Color(0xFF087F8C),

                        fontSize = 9.sp
                    )

                    Text(
                        text =
                            layerDescription(
                                selectedLayer
                            ),

                        color =
                            Color(0xFF17212B),

                        fontSize = 12.sp
                    )
                }
            }
        }

        // =========================================================
        // REFRESH
        // =========================================================

        Surface(

            modifier =
                Modifier
                    .align(
                        Alignment.BottomEnd
                    )
                    .padding(
                        end = 14.dp,
                        bottom = 16.dp
                    ),

            shape =
                CircleShape,

            color =
                Color.White.copy(
                    alpha = 0.95f
                )
        ) {

            IconButton(
                onClick = {
                    mapView?.invalidate()
                }
            ) {

                Icon(
                    imageVector =
                        Icons.Default.Refresh,

                    contentDescription =
                        "Refresh map",

                    tint =
                        Color(0xFF137CBD)
                )
            }
        }
    }
}


// =================================================================
// LAYER CHIP
// =================================================================

@Composable
private fun MapLayerChip(
    text: String,
    selected: Boolean,
    onClick: () -> Unit
) {

    FilterChip(

        selected =
            selected,

        onClick =
            onClick,

        label = {
            Text(
                text =
                    text,

                fontSize =
                    11.sp
            )
        }
    )
}


// =================================================================
// LAYER ICON
// =================================================================

@Composable
private fun LayerIcon(
    layer: String
) {

    val icon =
        when (layer) {

            "Rain" ->
                Icons.Default.WaterDrop

            "Flood" ->
                Icons.Default.Warning

            "Alerts" ->
                Icons.Default.Warning

            "Dams" ->
                Icons.Default.WaterDrop

            "Quakes" ->
                Icons.Default.Warning

            else ->
                Icons.Default.Cloud
        }

    Icon(
        imageVector =
            icon,

        contentDescription =
            layer,

        tint =
            Color(0xFF137CBD),

        modifier =
            Modifier.size(21.dp)
    )
}


// =================================================================
// DESCRIPTION
// =================================================================

private fun layerDescription(
    layer: String
): String {

    return when (layer) {

        "Rain" ->
            "Rainfall intensity"

        "Flood" ->
            "Flood-risk zones"

        "Alerts" ->
            "Official warnings"

        "Dams" ->
            "Reservoir monitoring"

        "Quakes" ->
            "Earthquake activity"

        else ->
            "Current weather conditions"
    }
}
